# Copy to .env (`make up` does this for you). Read by docker compose for
# variable interpolation and passed to the backend container.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Host ports. Defaults avoid membrain's (5173 / 8110) so both stacks can run.
FRONTEND_PORT=5174
BACKEND_PORT=8000
PROD_FRONTEND_PORT=8080

# SurrealDB Agent Memory (SurrealDB Cloud -> your Context -> API keys).
# Endpoint is the Context's origin, no trailing slash and no /api/v1.
# Leave blank and the app still runs; /api/v1/health/ready reports not_configured.
AGENT_MEMORY_ENDPOINT=
AGENT_MEMORY_CONTEXT=
AGENT_MEMORY_API_KEY=
