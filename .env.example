# Copy to .env (`make up` does this for you). Read by docker compose for
# variable interpolation and passed to the backend container.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Host ports. Defaults avoid membrain's (5173 / 8110) so both stacks can run.
FRONTEND_PORT=5174
BACKEND_PORT=8000
SURREAL_PORT=8001
PROD_FRONTEND_PORT=8080

# SurrealDB root credentials, shared by the surrealdb and backend services.
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=membrain
SURREAL_DATABASE=poc
